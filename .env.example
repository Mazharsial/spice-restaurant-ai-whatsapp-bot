# Copy this file to ".env" and fill in your real values.
# The .env file is git-ignored and must NEVER be committed.

# --- Postgres ---
POSTGRES_PASSWORD=change_me_to_a_strong_password

# --- Google Gemini ---
# Get a key at https://aistudio.google.com/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# --- Meta WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_WABA_ID=your_whatsapp_business_account_id_here
WHATSAPP_VERIFY_TOKEN=choose_any_secret_string_for_webhook_verification
