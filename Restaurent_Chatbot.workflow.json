                  {
                      "id":  "reply",
                      "name":  "Build Reply",
                      "parameters":  {
                                         "jsCode":  "const r = $input.first().json;\nlet reply = r?.candidates?.[0]?.content?.parts?.[0]?.text;\nif (!reply) { reply = \"Sorry, I had a little trouble there. Could you please repeat that? ðŸ™\"; }\nreply = reply.trim();\nconst p = $(\u0027Parse Message\u0027).first().json;\nreturn [{\n  json: {\n    reply: reply,\n    from: p.from,\n    name: p.name,\n    user_text: p.text,\n    message_id: p.messageId\n  }\n}];"
                                     },
