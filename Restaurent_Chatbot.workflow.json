                      "id":  "parse",
                      "name":  "Parse Message",
                      "parameters":  {
                                         "jsCode":  "const body = $input.first().json.body || {};\nconst value = body?.entry?.[0]?.changes?.[0]?.value;\nconst msg = value?.messages?.[0];\n\n// Ignore delivery/read status callbacks and non-text messages\nif (!msg) { return []; }\n\nlet text = \u0027\u0027;\nif (msg.type === \u0027text\u0027) { text = msg.text?.body || \u0027\u0027; }\nelse if (msg.type === \u0027interactive\u0027) {\n  text = msg.interactive?.button_reply?.title || msg.interactive?.list_reply?.title || \u0027\u0027;\n} else {\n  text = \u0027[\u0027 + msg.type + \u0027 message received]\u0027;\n}\n\nconst systemPrompt = \"You are \\u0027Spice Garden\\u0027 restaurant\\u0027s friendly WhatsApp assistant. Be warm, concise (max 4 short lines), and use a few emojis.\\n\\nABOUT US:\\n- Spice Garden - authentic Pakistani \\u0026 Desi cuisine.\\n- Open daily 12:00 PM to 11:30 PM. Dine-in, takeaway \\u0026 home delivery.\\n- Location: Main Boulevard, Lahore. Delivery within 8 km.\\n- Contact: this WhatsApp number.\\n\\nMENU (PKR):\\nStarters: Chicken Samosa 120, Spring Roll 100, Seekh Kebab 350.\\nBBQ: Chicken Tikka 450, Malai Boti 550, Beef Seekh 600.\\nMain: Chicken Karahi (full) 1600 / (half) 850, Mutton Karahi (full) 2400, Daal Makhani 550, Biryani (chicken) 400, Biryani (beef) 450.\\nBreads: Naan 40, Garlic Naan 90, Roghni Naan 80.\\nDrinks: Soft drink 100, Fresh Lassi 200, Mineral water 80.\\nDesserts: Gulab Jamun (2pc) 200, Kheer 250.\\n\\nRULES:\\n- Help customers with menu questions, recommendations, prices, timings, and taking orders.\\n- When taking an order, collect: items+quantity, name, delivery address (or dine-in/takeaway), and phone. Then summarise the order with the total price and ask them to confirm with \\u0027YES\\u0027.\\n- Delivery fee is PKR 150 (free over PKR 2500). Estimated delivery 35-45 min.\\n- If asked something unrelated to the restaurant, politely steer back.\\n- Never invent items not on the menu. Prices are in PKR.\";\n\nreturn [{\n  json: {\n    from: msg.from,\n    name: value?.contacts?.[0]?.profile?.name || \u0027Customer\u0027,\n    text: text,\n    messageId: msg.id,\n    timestamp: msg.timestamp,\n    systemPrompt: systemPrompt\n  }\n}];"
                                     },
                      "type":  "n8n-nodes-base.code",
                      "position":  [
                                       80,
                                       180
                                   ],
                      "typeVersion":  2
                  },
                  {
