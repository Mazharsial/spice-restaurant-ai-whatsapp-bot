                                         "specifyBody":  "json",
                                         "jsonBody":  "={{ { \"system_instruction\": { \"parts\": [ { \"text\": $json.systemPrompt } ] }, \"contents\": [ { \"role\": \"user\", \"parts\": [ { \"text\": $json.text } ] } ], \"generationConfig\": { \"temperature\": 0.6, \"maxOutputTokens\": 700 } } }}",
                                         "url":  "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
                                         "options":  {

                                                     },
                                         "sendQuery":  true,
                                         "sendBody":  true
                                     },
